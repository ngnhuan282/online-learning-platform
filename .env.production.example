# Copy to .env.production. Use independent random hex secrets (32+ bytes each).
PRODUCTION_ORIGIN=
RELEASE_TAG=
IMAGE_REGISTRY=sgsphere
PRODUCTION_WEB_PORT=8088
# Exact IP/CIDR of the TLS reverse proxy as seen from the web container.
TRUSTED_PROXY_CIDR=
MYSQL_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
COURSE_DB_PASSWORD=
LEARNING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
AI_DB_PASSWORD=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
JWT_ISSUER=sgedu
JWT_ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
PAYMENT_MOCK_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_TYPE=s3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
# Leave credentials empty for an IAM role; fill both when using explicit credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_PUBLIC_ENDPOINT_URL=
AWS_S3_FORCE_PATH_STYLE=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Fill the production URL supplied with your merchant credentials when enabling payments.
VNPAY_PAYMENT_URL=
VNPAY_EXPIRE_MINUTES=15
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_DAILY_REQUEST_LIMIT=100
LOG_FORMAT=ecs
