log_format safe '$request_method $status $request_time requestId=$upstream_http_x_request_id';
limit_req_zone $binary_remote_addr zone=authentication:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 210m;
    access_log /dev/stdout safe;
    error_log /dev/stderr crit;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway_upstream http://api-gateway:8080;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Real-IP;
    real_ip_recursive off;
    limit_req_status 429;
    error_page 429 = @rate_limited;
    include /etc/nginx/production-headers.conf;

    location @rate_limited {
        default_type application/json;
        include /etc/nginx/production-headers.conf;
        add_header Retry-After 60 always;
        return 429 '{"success":false,"code":"RATE_LIMITED","message":"Too many requests. Please try again later.","errors":null,"timestamp":"$time_iso8601","path":"/api"}';
    }
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP"}';
    }
    location ~ ^/api/v1/auth/(login|register|forgot-password|reset-password)$ {
        limit_req zone=authentication burst=10 nodelay;
        include /etc/nginx/production-proxy.conf;
    }
    location /api/ {
        limit_req zone=api burst=100 nodelay;
        include /etc/nginx/production-proxy.conf;
    }
    location ~ ^/(v3/api-docs|swagger-ui|internal)(/|$) { return 404; }
    location = /swagger-ui.html { return 404; }
    location /actuator/health {
        proxy_pass $gateway_upstream;
    }
    location ~ ^/(auth/google/callback|reset-password)$ {
        include /etc/nginx/production-headers.conf;
        add_header Cache-Control no-store always;
        add_header Referrer-Policy no-referrer always;
        try_files /index.html =404;
    }
    location /assets/ {
        include /etc/nginx/production-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/production-headers.conf;
        add_header Cache-Control no-cache always;
        try_files $uri $uri/ /index.html;
    }
}
