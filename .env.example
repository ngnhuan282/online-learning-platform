# Local template only. Fill required values; never commit the real .env.
# Generate independent random database passwords using base64 or hex.
MYSQL_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
COURSE_DB_PASSWORD=
LEARNING_DB_PASSWORD=
# Optional server-to-server notification receiver key. Empty disables the receiver.
NOTIFICATION_EVENT_API_KEY=
PAYMENT_DB_PASSWORD=
AI_DB_PASSWORD=
# At least 32 UTF-8 bytes, generated randomly; identical in all six backend processes.
JWT_SECRET=
JWT_ISSUER=learnsphere
JWT_ACCESS_TOKEN_SECONDS=900
# Independent secret for direct Payment -> Learning requests (at least 32 UTF-8 bytes).
INTERNAL_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Staging overlay serves web and API under one HTTPS origin.
STAGING_ORIGIN=https://staging.example.com
STAGING_WEB_PORT=8088
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
MYSQL_PORT=3306
LOG_FORMAT=ecs

REFRESH_TOKEN_EXPIRATION_SECONDS=604800
# Set true behind HTTPS in production. Local HTTP development uses false.
REFRESH_COOKIE_SECURE=false

# Week 8 test stacks: set true explicitly. Keep false outside the MOCK demonstration.
PAYMENT_MOCK_ENABLED=false
# Sandbox credentials alone do not implement VNPay D9. See docs/deployment/A8_A9_REPORT.md.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
# For local S3-compatible dev (MinIO/LocalStack), set the endpoint and path-style flag.
AWS_ENDPOINT_URL=
AWS_PUBLIC_ENDPOINT_URL=
AWS_S3_FORCE_PATH_STYLE=true
# Set STORAGE_TYPE=s3 and provide a bucket plus AWS credentials to enable S3.
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-this-local-secret
# Local RustFS example (also start Compose with --profile backend --profile s3):
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=elearning-media
# AWS_ENDPOINT_URL=http://rustfs:9000
# AWS_PUBLIC_ENDPOINT_URL=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=rustfsadmin
# AWS_SECRET_ACCESS_KEY=change-this-local-secret
AI_API_KEY=
